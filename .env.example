# Never commit a real key. Revoke any key pasted into chat or source control.

# ===== Provider chain =====
# Primary: OpenCode Zen's free Ox Alpha Free model (keyless, zero-retention).
# Fallback order: Zen Big Pickle (keyless) -> NVIDIA (needs key) -> gpt4free (auto).
PRIMARY_PROVIDER=zen
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=x-preview-f-free
OPENCODE_ZEN_BIGPICKLE_MODEL=big-pickle

# ===== NVIDIA fallback (optional) =====
# Leave NVIDIA_API_KEY empty to run on Zen + gpt4free alone.
NVIDIA_API_KEY=nvapi-replace-me
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
MAX_TOKENS=16384
TEMPERATURE=0.2
TOP_P=0.95

# ===== gpt4free last-resort (auto) =====
# G4F_ENABLED=on benchmarks every working text provider once, ranks them
# (working first, then largest context limit, then fastest), caches the
# ranking in automation/cache/, and uses the best-ranked provider only when
# Zen/NVIDIA all fail.
G4F_ENABLED=on
G4F_MAX_AGE_HOURS=24

# ===== Concurrency & pacing =====
# Parallel worker threads (default 1 = sequential). With >1, all LLM calls
# across threads share one rate cap (below) plus exponential backoff — the
# pipeline only sleeps when the cap would be exceeded, never "just in case".
PIPELINE_WORKERS=5
LLM_CALLS_PER_MINUTE=25
# How many benchmarked Zen free models to keep in the chain (best first).
ZEN_MAX_MODELS=1

# ===== Search backends (Python-only automation) =====
# YaCy: local peer at http://localhost:8090 (https://github.com/yacy/yacy_search_server)
YACY_SEARCH=on
YACY_URL=http://localhost:8090
# Dokobot: optional local browser search CLI.
DOKO_SEARCH=off

# ===== Safety controls =====
# Hard gate for the validator; the generation prompt targets 4,000-8,000 words
# (up to 15,000 for foundational or highly complex works).
BOOK_MIN_WORDS=2500
BOOK_MAX_WORDS=15000
