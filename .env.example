# ==============================================================================
# BOOK VAULT — CONFIGURATION ENVIRONMENT (.env.example)
# Copy this file to .env and adjust values to customize your pipeline.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY PROVIDER & OPENCODE ZEN
# ------------------------------------------------------------------------------
# Primary provider: 'zen' (free keyless OpenCode Zen API) or 'nvidia'
PRIMARY_PROVIDER=zen

# OpenCode Zen API Key (Optional for free tier, or paste your OpenCode Zen key)
OPENCODE_ZEN_API_KEY=your-zen-api-key-here
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=x-preview-f-free

# 7 retries for Zen Ox Alpha primary model:
ZEN_OX_ALPHA_RETRIES=7
ZEN_FALLBACK_RETRIES=0

# Complete fallback chain of tested models in order:
ZEN_FALLBACK_MODELS=nemotron-3-ultra-free,laguna-s-2.1-free,nemotron-3.5-lightning-free,muse-spark-1.2-contributor-free,hy3-free,big-pickle
ZEN_MAX_MODELS=11

# ------------------------------------------------------------------------------
# 2. NVIDIA AI API (OPTIONAL HIGH-PERFORMANCE BACKUP)
# ------------------------------------------------------------------------------
# Get your free key at https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_MAX_TOKENS=65536
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.95
NVIDIA_REQUESTS_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 3. LLM GENERATION HYPERPARAMETERS & RETRY CONTROLS
# ------------------------------------------------------------------------------
MAX_TOKENS=65536
TEMPERATURE=0.2
TOP_P=0.95
LLM_RETRIES=0
FALLBACK_RETRIES=0
LLM_CALLS_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 4. RESEARCH SEARCH ENGINES & KNOWLEDGE RETRIEVAL
# ------------------------------------------------------------------------------
DDGS_SEARCH=on
OPENLIBRARY_SEARCH=on
WIKIPEDIA_SEARCH=on
CROSSREF_SEARCH=on
SEARCH_RETRIES=5

# Dokobot local browser search
DOKO_SEARCH=off

# YaCy Decentralized P2P Search
YACY_SEARCH=off
YACY_URL=http://localhost:8090

# Optional Exa.ai API (Semantic neural book research)
EXA_API_KEY=your-exa-api-key-here
EXA_NUM_RESULTS=8
EXA_MAX_HIGHLIGHT_CHARS=1200

# ------------------------------------------------------------------------------
# 5. GPT4FREE (G4F) LAST-RESORT BACKUP
# ------------------------------------------------------------------------------
G4F_ENABLED=on
G4F_MAX_AGE_HOURS=24

# ------------------------------------------------------------------------------
# 6. PIPELINE WORD COUNT TARGETS & CONCURRENCY
# ------------------------------------------------------------------------------
BOOK_MIN_WORDS=2500
BOOK_MAX_WORDS=15000
PIPELINE_WORKERS=10
